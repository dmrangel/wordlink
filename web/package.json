{
  "name": "wordlink-web",
  "private": true,
  "version": "1.0.0",
  "description": "Wordlink as an installable web app (PWA), sharing the Kotlin game engine with Android.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "core": "cd .. && ./gradlew :core:jsProductionLibraryDistribution",
    "assets": "node scripts/assets.mjs",
    "dev": "npm run assets && vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run assets && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
